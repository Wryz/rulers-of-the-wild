+    expect(pulls.slice(first + VERB_TUNING.pullYankTicks).every((x) => x === VERB_TUNING.pullForceN)).toBe(true);
+    expect(lengths[0] - lengths[lengths.length - 1]).toBeGreaterThan(2.5);
