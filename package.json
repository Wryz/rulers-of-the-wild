{
  "name": "rulers-of-the-wild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w apps/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:accept": "vitest run --project sim tests/ac1.noTrapTypes tests/ac2.traps tests/ac3.soloHunt tests/ac4.rule5 tests/ac5.rulerTrip tests/ac6.bodies tests/ac7.determinism",
    "test:rehearsal": "ROTW_REHEARSAL=1 vitest run rehearsal"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
