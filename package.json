{
  "name": "rulers-of-the-wild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w apps/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
